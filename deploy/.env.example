# 복사해서 .env 로 쓰고 값을 채운다. .env 는 절대 커밋하지 않는다.
SERVER_NAME=hamkke.example.kr
CERT_DIR=./certs

DB_NAME=hamkke
DB_USER=hamkke
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

# 32자 이상 난수. 예: openssl rand -base64 48
JWT_SECRET=

# ── AI 관찰 기록 (docs/ai-observation.md). 쓰지 않으면 아래는 그대로 둔다(기본: 꺼짐) ──
# 켜려면 세 값을 함께 채운다: AI_ENABLED=true, AI_SHARED_SECRET, COMPOSE_PROFILES=ai
AI_ENABLED=false
# api 와 ai 서버가 함께 쓰는 서명 키. 32바이트 이상 난수이며 JWT_SECRET 과 반드시 다른 값.
# 예: openssl rand -base64 48   (JWT_SECRET 을 만들 때와 따로 한 번 더 실행한다)
AI_SHARED_SECRET=
# 'ai' 를 넣으면 ai 서비스(hamkke-ai server/)가 함께 뜬다. 비워 두면 뜨지 않는다.
COMPOSE_PROFILES=
# VL 모델을 돌리는 Ollama 주소. GPU 가 있는 기기를 가리킨다(기본값은 이 서버에서 도는 Ollama).
OLLAMA_URL=http://host.docker.internal:11434
VL_MODEL=qwen3.5:4b
# 동시에 분석하는 수(기본 1)와 모델 제한 시간(밀리초, 기본 180초)
VL_MAX_CONCURRENCY=1
VL_TIMEOUT_MS=180000
