# 복사해서 .env 로 쓰고 값을 채운다. .env 는 절대 커밋하지 않는다.
SERVER_NAME=hamkke.example.kr
CERT_DIR=./certs

DB_NAME=hamkke
DB_USER=hamkke
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

# 32자 이상 난수. 예: openssl rand -base64 48
JWT_SECRET=

# ── AI 관찰 기록 (docs/ai-observation.md). 쓰지 않으면 아래는 그대로 둔다(기본: 꺼짐) ──
# 켜려면 세 값을 함께 채운다: AI_ENABLED=true, AI_SHARED_SECRET, COMPOSE_PROFILES=ai
AI_ENABLED=false
# api 와 ai 서버가 함께 쓰는 서명 키. 32바이트 이상 난수이며 JWT_SECRET 과 반드시 다른 값.
# 예: openssl rand -base64 48   (JWT_SECRET 을 만들 때와 따로 한 번 더 실행한다)
AI_SHARED_SECRET=
# 'ai' 를 넣으면 ai 서비스(hamkke-ai server/)가 함께 뜬다. 비워 두면 뜨지 않는다.
COMPOSE_PROFILES=
# VL 모델을 돌리는 Ollama 주소. GPU 가 있는 기기를 가리킨다(기본값은 이 서버에서 도는 Ollama).
OLLAMA_URL=http://host.docker.internal:11434
VL_MODEL=qwen3.5:4b
# 동시에 분석하는 수(기본 1)와 모델 제한 시간(밀리초, 기본 180초)
VL_MAX_CONCURRENCY=1
VL_TIMEOUT_MS=180000
# 아래는 비워 두면 서버 기본값을 쓴다(뜻은 hamkke-ai docs/observation.md 2장, hamkke-api docs/deploy.md 2.1절).
# 기다릴 수 있는 요청 수(기본 2)와 차례를 기다리는 시간의 상한(밀리초, 기본 VL_TIMEOUT_MS 의 절반)
VL_MAX_WAITING=
VL_MAX_WAIT_MS=
# 모델을 메모리에 두는 시간(compose 기본 30m). 뜬 뒤 모델을 미리 올려 둘지(compose 기본 true)
VL_KEEP_ALIVE=30m
VL_WARMUP=true
# 문맥 길이(기본 8192)와 한 번에 만드는 토큰 수 상한(기본 480)
VL_NUM_CTX=
VL_MAX_OUTPUT_TOKENS=
# 첫 모델을 쓸 수 없을 때 대신 쓰는 모델(선택). 영수증에는 실제로 쓴 모델 이름이 남는다.
VL_FALLBACK_MODEL=
VL_FALLBACK_URL=
# Ollama 를 다른 기기에 두고 TLS 프록시로 감쌌을 때 그 프록시의 토큰(선택). 비우면 보내지 않는다.
OLLAMA_AUTH_TOKEN=
OLLAMA_AUTH_HEADER=
# 바깥 주소를 http(평문)로 가리키면 ai 서버가 기동하지 않는다. 꼭 그래야 할 때만 true(권하지 않음).
OLLAMA_ALLOW_INSECURE=false
# /ai/v1/metrics 를 읽을 때 필요한 Bearer 토큰(선택, 16자 이상). 예: openssl rand -hex 24
# 이 경로는 nginx 가 밖에서 막는다(같은 docker 망의 수집기만 읽는다).
METRICS_TOKEN=

# ── 백업 (docs/deploy.md 5장, deploy/backup.sh) ──
# 백업 파일을 올릴 S3 주소(예: s3://hamkke-backup/mysql). 비우면 이 서버에만 둔다.
BACKUP_S3_URI=
# S3 서버 측 암호화: AES256(기본) 또는 aws:kms (aws:kms 면 BACKUP_S3_KMS_KEY_ID 로 키를 정할 수 있다)
BACKUP_S3_SSE=AES256
BACKUP_S3_KMS_KEY_ID=
# 백업 파일을 둘 폴더(비우면 ~/backup)와 이 서버에 두는 일수(기본 7). S3 보관 기간은 버킷 수명 주기 규칙(30일)으로 정한다.
BACKUP_DIR=
BACKUP_KEEP_DAYS=7
# 정하면 gpg(AES256)로 한 번 더 암호화한다. 암호 파일(권한 600)의 사본은 서버 밖 안전한 곳에 둔다.
BACKUP_PASSPHRASE_FILE=
